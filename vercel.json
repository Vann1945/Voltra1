{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/streak",
      "destination": "/"
    },
    {
      "source": "/home",
      "destination": "/"
    },
    {
      "source": "/home/:path*",
      "destination": "/"
    },
    {
      "source": "/addon/:path*",
      "destination": "/"
    },
    {
      "source": "/voltra",
      "destination": "/"
    },
    {
      "source": "/voltra/streak",
      "destination": "/"
    },
    {
      "source": "/voltra/home",
      "destination": "/"
    },
    {
      "source": "/voltra/home/:path*",
      "destination": "/"
    },
    {
      "source": "/((?!api/|assets/|fonts/|.*\\.(?:css|js|mjs|json|ico|png|jpg|jpeg|svg|webp|gif|woff|woff2|ttf|eot|map|txt|xml)$).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.cloudinary.com https://api.imgbb.com https://www.google.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com; frame-src https://www.google.com https://www.youtube-nocookie.com https://www.youtube.com https://visualize-void.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'; require-trusted-types-for 'script'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
